--- /dev/null
+++ after/nvml_metrics.py
@@ -0,0 +1,51 @@
+# Local read-only N1X telemetry. No CUDA allocation, retries or stale fallback.
+import atexit
+import ctypes
+import time
+
+LIBRARY = '/usr/lib/wsl/lib/libnvidia-ml.so.1'
+
+class NvmlError(RuntimeError):
+    pass
+
+class Memory(ctypes.Structure):
+    _fields_ = [('total',ctypes.c_ulonglong),('free',ctypes.c_ulonglong),('used',ctypes.c_ulonglong)]
+
+class NvmlMemory:
+    def __init__(self, library=LIBRARY):
+        self.lib=ctypes.CDLL(library)
+        self.lib.nvmlInit_v2.argtypes=[];self.lib.nvmlInit_v2.restype=ctypes.c_int
+        self.lib.nvmlShutdown.argtypes=[];self.lib.nvmlShutdown.restype=ctypes.c_int
+        self.lib.nvmlDeviceGetCount_v2.argtypes=[ctypes.POINTER(ctypes.c_uint)]
+        self.lib.nvmlDeviceGetCount_v2.restype=ctypes.c_int
+        self.lib.nvmlDeviceGetHandleByIndex_v2.argtypes=[ctypes.c_uint,ctypes.POINTER(ctypes.c_void_p)]
+        self.lib.nvmlDeviceGetHandleByIndex_v2.restype=ctypes.c_int
+        self.lib.nvmlDeviceGetMemoryInfo.argtypes=[ctypes.c_void_p,ctypes.POINTER(Memory)]
+        self.lib.nvmlDeviceGetMemoryInfo.restype=ctypes.c_int
+        self.closed=True
+        self.check(self.lib.nvmlInit_v2(),'init');self.closed=False
+        try:
+            count=ctypes.c_uint();self.check(self.lib.nvmlDeviceGetCount_v2(ctypes.byref(count)),'count')
+            if count.value!=1:raise NvmlError('Expected one GPU; ambiguous identity')
+            self.handle=ctypes.c_void_p()
+            self.check(self.lib.nvmlDeviceGetHandleByIndex_v2(0,ctypes.byref(self.handle)),'handle')
+        except Exception:
+            self.close();raise
+        atexit.register(self.close)
+
+    @staticmethod
+    def check(code,op):
+        if code!=0:raise NvmlError('NVML '+op+' status '+str(code))
+
+    def read(self):
+        if self.closed:raise NvmlError('NVML handle closed')
+        mem=Memory();self.check(self.lib.nvmlDeviceGetMemoryInfo(self.handle,ctypes.byref(mem)),'memory')
+        result={'gpu_total':mem.total,'gpu_used':mem.used,'gpu_free':mem.free}
+        if not mem.total or mem.used>mem.total or mem.free>mem.total or mem.used+mem.free>mem.total:
+            raise NvmlError('Invalid NVML memory counters')
+        return result
+
+    def close(self):
+        if not self.closed:
+            self.closed=True
+            self.lib.nvmlShutdown()
